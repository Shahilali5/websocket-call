PORT=2083
# DB_CLIENT: 'sqlite' (zero-config local dev) or 'mysql'
DB_CLIENT=sqlite
DB_FILE=./vcall.sqlite

# MySQL settings (used when DB_CLIENT=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vcall
DB_PASS=strongpassword
DB_NAME=vcall

# STUN / TURN credentials (optional for localhost, required for production across different networks)
TURN_HOST=
TURN_SECRET=
